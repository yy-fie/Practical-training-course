<view class="page">
  <view class="title">修改登录密码</view>
  <view class="subtitle">修改后，所有设备上的旧登录会话都会失效。</view>
  <view wx:if="{{loading}}" class="empty">正在确认操作权限…</view>
  <view wx:elif="{{!allowed}}" class="empty">当前账号没有自助改密权限。</view>
  <view wx:else class="card">
    <view class="field"><label for="oldPassword" class="label">原密码</label><input id="oldPassword" class="input" focus-class="input-focus" password value="{{oldPassword}}" maxlength="128" data-field="oldPassword" bindinput="onInput" /></view>
    <view class="field"><label for="newPassword" class="label">新密码</label><input id="newPassword" class="input" focus-class="input-focus" password value="{{newPassword}}" maxlength="128" placeholder="至少 6 位" data-field="newPassword" bindinput="onInput" /></view>
    <view class="field"><label for="confirmPassword" class="label">确认新密码</label><input id="confirmPassword" class="input" focus-class="input-focus" password value="{{confirmPassword}}" maxlength="128" data-field="confirmPassword" bindinput="onInput" confirm-type="done" bindconfirm="submit" /></view>
    <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在修改' : '确认修改'}}</button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
</view>
