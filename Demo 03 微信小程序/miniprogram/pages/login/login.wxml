<view class="page">
  <view class="login-heading">
    <view class="badge">地铁客流 · 移动工作台</view>
    <view class="title"><view>随时查看站点</view><view>与客流数据</view></view>
    <view class="subtitle">使用已有系统账号，查看你的业务与权限。</view>
  </view>
  <view class="card">
    <view class="section-title">欢迎回来</view>
    <view class="field">
      <label for="username" class="label">手机号或邮箱</label>
      <input id="username" class="input" focus-class="input-focus" value="{{username}}" maxlength="200" placeholder="输入你的系统账号" data-field="username" bindinput="onInput" confirm-type="next" />
    </view>
    <view class="field">
      <label for="password" class="label">密码</label>
      <input id="password" class="input" focus-class="input-focus" password value="{{password}}" maxlength="128" placeholder="输入登录密码" data-field="password" bindinput="onInput" confirm-type="go" bindconfirm="submit" />
    </view>
    <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
    <button class="primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">{{submitting ? '正在登录' : '登录'}}</button>
  </view>
</view>
