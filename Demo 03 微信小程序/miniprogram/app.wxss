page {
  --primary: #1E40AF;
  --ink: #1E3A8A;
  --muted: #475569;
  --border: #DBEAFE;
  --danger: #B42318;
  background: #F8FAFC;
  color: #172554;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}
view, text, button, input { box-sizing: border-box; }
.page { padding: 32rpx; padding-bottom: 48rpx; }
.title { font-size: 44rpx; font-weight: 700; line-height: 1.35; }
.subtitle { color: var(--muted); margin-top: 12rpx; font-size: 28rpx; }
.section-title { font-size: 34rpx; font-weight: 600; margin: 32rpx 0 20rpx; }
.card { background: white; border: 1rpx solid var(--border); border-radius: 24rpx; padding: 32rpx; margin-top: 24rpx; }
.row { display: flex; align-items: center; justify-content: space-between; }
.muted { color: var(--muted); font-size: 26rpx; }
.badge { display: inline-block; background: #EFF6FF; color: var(--primary); border-radius: 12rpx; padding: 4rpx 16rpx; font-size: 24rpx; }
.field { margin-top: 24rpx; }
.label { display: block; margin-bottom: 12rpx; color: var(--ink); font-weight: 500; }
.input, .select { background: #F8FAFC; border: 2rpx solid var(--border); border-radius: 16rpx; min-height: 96rpx; width: 100%; padding: 20rpx 24rpx; font-size: 32rpx; }
.input-focus { border-color: var(--primary); }
button { font-size: 30rpx; font-weight: 500; border-radius: 16rpx; min-height: 96rpx; line-height: 1.6; padding: 22rpx 24rpx; margin-top: 24rpx; }
button::after { border: none; }
.primary { color: white; background: var(--primary); }
.secondary { color: var(--primary); background: #EFF6FF; border: 1rpx solid var(--border); }
.danger { color: var(--danger); background: #FFF1F2; }
button[disabled] { opacity: .6; }
.error { color: var(--danger); background: #FFF1F2; border-radius: 16rpx; padding: 20rpx; margin-top: 24rpx; overflow-wrap: break-word; }
.empty { padding: 64rpx 24rpx; text-align: center; color: var(--muted); }
.value { font-size: 48rpx; font-weight: 700; color: var(--ink); font-variant-numeric: tabular-nums; }
.two-columns { display: flex; flex-wrap: wrap; margin: 0 -8rpx; }
.two-columns > view { width: 50%; padding: 0 8rpx; }
.compact { padding: 24rpx; }
.link { color: var(--primary); }
.station-name { font-size: 36rpx; font-weight: 600; }
.station-meta { color: var(--muted); font-size: 26rpx; margin-top: 12rpx; }
.details-line { margin-top: 16rpx; display: flex; justify-content: space-between; flex-wrap: wrap; }
.details-line text { overflow-wrap: break-word; }
